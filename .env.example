# Supabase Configuration (From Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret token for Vercel Cron authentication (/api/cron/daily)
CRON_SECRET=your_super_secret_cron_token_here

# App URL (e.g. http://localhost:3000 for local dev or https://office-manager.vercel.app in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
